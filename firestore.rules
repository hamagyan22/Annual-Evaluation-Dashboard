rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'mohammed.dlshad0@gmail.com' ||
        request.auth.token.email == 'omar.ayad@fib.iq' ||
        request.auth.token.email == 'Omar.Ayad@fib.iq'
      );
    }

    function isManager() {
      return isAdmin() || (isAuthenticated() && request.auth.token.email == 'jalal.burghol@agent.com');
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Team members directory
    match /team_members/{memberId} {
      allow read, write: if true;
    }

    // KPI Columns configuration (Super Admin only can edit KPIs)
    match /columns_config/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Younis Kamal metrics
    match /younis_metrics/{metricId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isManager() || 
        request.auth.token.email == 'younis.kamal@agent.com' ||
        request.auth.token.email == 'younis.kamal.tl@agent.com'
      );
    }

    // Ankido Buya metrics
    match /ankido_metrics/{metricId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isManager() || 
        request.auth.token.email == 'ankido.buya@agent.com'
      );
    }

    // Mohammed Dlshad metrics
    match /mohammed_metrics/{metricId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Global Settings (Top Star criteria & sync status)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        request.auth.token.email == 'younis.kamal@agent.com' || 
        request.auth.token.email == 'younis.kamal.tl@agent.com' || 
        request.auth.token.email == 'ankido.buya@agent.com'
      );
    }

    // Quality evaluations & sync configuration
    match /quality_evaluations/{evalId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin() || 
        isManager() || 
        request.auth.token.email == 'younis.kamal@agent.com' || 
        request.auth.token.email == 'younis.kamal.tl@agent.com' || 
        request.auth.token.email == 'ankido.buya@agent.com' ||
        request.auth.token.email == 'lara.qa@agent.com' ||
        request.auth.token.email == 'mohammed.jihad@agent.com' ||
        request.auth.token.email == 'mohammed.jihad.qa@agent.com' ||
        request.auth.token.email == 'mohammed.azad@agent.com' ||
        request.auth.token.email == 'mohammed.azad.qa@agent.com'
      );
    }

    // Annual evaluations & criteria
    match /annual_evaluations/{evalId} {
      allow read, write: if true;
    }

    match /evaluation_criteria/{critId} {
      allow read, write: if true;
    }

    match /evaluation_departments/{deptId} {
      allow read, write: if true;
    }

    match /evaluation_employees/{empId} {
      allow read, write: if true;
    }

    // Deny all other unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
